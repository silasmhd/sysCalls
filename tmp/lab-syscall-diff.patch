+uint64
+sys_trace(void){
+  int mask;
+  if (argint(0, &mask) < 0) {
+    return -1;
+  }
+
+  myproc()->trace_mask = mask;
+  return 0;
+}
+
+
+uint64
+sys_sysinfo(void){
+
+  struct proc *p = myproc();
+
+  uint64 destadd = p->trapframe->a0;
+
+  struct sysinfo info;
+
+  info.freemem = freemem();
+  info.nproc = nproc();
+
+  if(copyout(p->pagetable, destadd, (char *)&info, sizeof(info)) < 0)
+      return -1;
+
+
+  return 0;
+}
